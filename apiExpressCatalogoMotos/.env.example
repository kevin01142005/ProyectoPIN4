# Puerto de la API (en el despliegue, el hosting lo define solo con la variable PORT)
PORT=4000

# --- Base de datos MySQL (XAMPP: usuario root y SIN contraseña) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=catalogo_motos

# Si se llena, se usa en lugar de los DB_* (por ejemplo, la base de datos en la nube)
DATABASE_URL=

DB_SSL=false
